{
  "name": "ledger",
  "version": "1.0.0",
  "description": "Double-entry ledger service (TypeScript + Postgres)",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "migrate": "node src/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "bench": "node scripts/bench-posting.ts",
    "bench:balances": "node scripts/bench-balances.ts",
    "start": "node src/server.ts",
    "load": "node scripts/load.ts",
    "demo:fund": "node scripts/fund-demo.ts"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "autocannon": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
